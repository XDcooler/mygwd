rulesRepository="${DE_GWD_RULES_REPOSITORY:-XDcooler/mygwd}"
rulesBranch="${DE_GWD_RULES_BRANCH:-main}"
# Migrate the old project source before constructing any download URL.
case "$(printf '%s' "$rulesRepository" | tr '[:upper:]' '[:lower:]')" in
    xdcooler/de_gwd|jacyl4/de_gwd)
        rulesRepository=XDcooler/mygwd
        yellow "Legacy project source replaced with XDcooler/mygwd; verify any pinned branch belongs to mygwd.";;
esac
sourceDirectory=$(cd -- "$(dirname -- "$serverSourcePath")" && pwd)

requireRoot(){
[[ $EUID == 0 ]] || { red "Run this command as root (sudo bash server ...)."; return 1; }
}

runServerStage(){
serverPhase=$1
"$@"
}

runServerOperation(){
(
requireRoot || exit 1
requireDebian13 || exit 1
install -d -m0700 /run/mygwd-server || exit 1
exec 9>/run/mygwd-server/operation.lock
flock -n 9 || { red "Another server operation is running."; exit 1; }
serverPhase=preflight
serverCronStopped=0
trap 'result=$?; trap - EXIT; if [[ $serverCronStopped == 1 ]]; then service cron restart || result=1; fi; if [[ $result != 0 ]]; then red "Server operation failed at $serverPhase (exit $result)."; fi; exit "$result"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
"$@"
)
}

runKernelUpdate(){
local helper
requireRoot || return 1
requireDebian13 || return 1
helper=$(mktemp /tmp/mygwd-kernel.XXXXXX) || return 1
copyOrDownloadAsset scripts/update-kernel.sh "$helper" || { rm -f "$helper"; return 1; }
bash -n "$helper" || { rm -f "$helper"; return 1; }
bash "$helper" "$@"
local result=$?
rm -f "$helper"
return "$result"
}

installRulesUpdater(){
mkdir -p /opt/de_GWD
if [[ -f "$sourceDirectory/resource/client/ui-script/ui-updateRules" ]]; then
    cp -f "$sourceDirectory/resource/client/ui-script/ui-updateRules" /opt/de_GWD/ui-updateRules
else
    curl -fsSL --proto '=https' --proto-redir '=https' \
        "https://raw.githubusercontent.com/$rulesRepository/$rulesBranch/resource/client/ui-script/ui-updateRules" \
        -o /opt/de_GWD/ui-updateRules.download || return 1
    mv -f /opt/de_GWD/ui-updateRules.download /opt/de_GWD/ui-updateRules
fi
chmod +x /opt/de_GWD/ui-updateRules
}

copyOrDownloadAsset(){
local asset=$1 destination=$2 staging
staging=$(mktemp "${destination}.download.XXXXXX") || return 1
if [[ -f "$sourceDirectory/$asset" ]]; then
    cp -f "$sourceDirectory/$asset" "$staging" || { rm -f "$staging"; return 1; }
else
    curl -fsSL --proto '=https' --proto-redir '=https' \
        "https://raw.githubusercontent.com/$rulesRepository/$rulesBranch/$asset" -o "$staging" || { rm -f "$staging"; return 1; }
fi
mv -f "$staging" "$destination" || { rm -f "$staging"; return 1; }
}


piholePasswordHashIsValid(){
[[ ${1:-} =~ ^[[:xdigit:]]{64}$ && ${1:-} =~ [1-9a-fA-F] ]]
}

preparePiholePassword(){
local savedHash
savedHash=$(awk -F= '$1 == "WEBPASSWORD" {print $2; exit}' /etc/pihole/setupVars.conf 2>/dev/null)
if piholePasswordHashIsValid "$savedHash"; then
    piholePW=$savedHash
elif ! piholePasswordHashIsValid "${piholePW:-}"; then
    # This role has no web login. A seed hash is needed only for v5 migration.
    piholePW=$(python3 -c 'import secrets; print(secrets.token_hex(32))') || return 1
fi
piholePasswordHashIsValid "$piholePW"
}





