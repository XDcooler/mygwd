serverUsage(){
cat <<'USAGE'
mygwd server (Debian 13 amd64/arm64)
Usage: sudo bash server [OPTION]
  --install [DOMAIN[:PORT]]  Install; port 443 uses ACME HTTP validation.
  --update                  Update the installed server application.
  --kernel-check            Show the kernel APT plan without installing.
  --update-kernel           Install the matching Debian kernel metapackage.
  --enable-bbr              Enable BBR in the running kernel.
  --help                    Show this help.
Without an option, open the interactive menu. Kernel installation keeps old
kernels and requires a later manual reboot; BBR alone does not update kernels.
USAGE
}

case "${1:-}" in
    --help|-h) serverUsage;;
    --install)
        [[ $# -le 2 ]] || { serverUsage >&2; exit 2; }
        runServerOperation installGWD "${2:-}";;
    --update) [[ $# == 1 ]] || exit 2; runServerOperation updateGWD;;
    --kernel-check) [[ $# == 1 ]] || exit 2; runKernelUpdate --check;;
    --update-kernel) [[ $# == 1 ]] || exit 2; runKernelUpdate --install;;
    --enable-bbr) [[ $# == 1 ]] || exit 2; installBBR;;
    '') requireRoot && requireDebian13 && start_menu;;
    *) serverUsage >&2; exit 2;;
esac
