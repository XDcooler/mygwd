    vpsdomainP=$1
else
    green "=================="
    green " Input VPS domain"
    green "=================="
    IFS= read -r vpsdomainP || return 1
fi

domain=${vpsdomainP%%:*}
local domainPattern='^([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\.)+[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$'
[[ ${#domain} -le 253 && $domain =~ $domainPattern ]] || { red "Supply a valid DNS domain, optionally followed by :PORT."; return 1; }
topDomain=$(echo $domain | rev | awk -F. '{print $1"."$2}' | rev)
port=443
if [[ $vpsdomainP == *:* ]]; then
    port=${vpsdomainP#*:}
    [[ $port =~ ^[0-9]{1,5}$ ]] && ((10#$port >= 1 && 10#$port <= 65535)) || { red "Invalid HTTPS port."; return 1; }
    port=$((10#$port))
fi

if [[ $port != "443" ]]; then
    green "==============================="
    green " Cloudflare API KEY"
    green "==============================="
    IFS= read -r -s CFapikey || return 1
    echo

    green "==============================="
    green " Cloudflare Email"
    green "==============================="
    IFS= read -r CFemail || return 1
fi

uuids=$(cat /proc/sys/kernel/random/uuid)
path="/$(echo $uuids | awk '{print substr($0,length($1)-5)}')"

ethernetnum=$(ip --oneline link show up | grep -v "lo" | awk '{print $2}' | cut -d':' -f1 | cut -d'@' -f1 | awk 'NR==1{print}')
ethernetnums=$(ip --oneline link show up | grep -v "lo" | awk '{print $2}' | cut -d':' -f1 | cut -d'@' -f1 | xargs | sed 's/ /,/g')
localaddr=$(ip -4 a | grep inet | grep -v 127.0.0 | awk '{print $2}' | cut -d'/' -f1 | head -n 1)

runServerStage preInstall || return 1

runServerStage installPihole || return 1

runServerStage piholeSet || return 1

runServerStage installIptablesRules || return 1

runServerStage installDOH || return 1

runServerStage installNginx || return 1

runServerStage installXray || return 1

if [[ $port == "443" ]]; then
runServerStage makeSSL_W || return 1
else
runServerStage makeSSL_D || return 1
fi

runServerStage ocspStapling || return 1

runServerStage nginxWebConf || return 1

runServerStage xrayInbound || return 1

runServerStage xrayOutboundDirect || return 1

runServerStage postInstall || return 1

printNode || return 1

blue "----------------------"
blue  "Install de_GWD [done]"
blue "----------------------"
}



updateGWD(){
requireDebian13 || return 1
[[ $(cat /opt/de_GWD/role 2>/dev/null) == server || -f /opt/de_GWD/version.php ]] || { red "this is not server"; return 1; }

runServerStage preUpdate || return 1

runServerStage preInstall || return 1

runServerStage installPihole || return 1

runServerStage piholeSet || return 1

runServerStage installIptablesRules || return 1

runServerStage installDOH || return 1

runServerStage installNginx || return 1

runServerStage installXray || return 1

runServerStage nginxWebConf || return 1

runServerStage xrayInbound || return 1

if [[ -n $xtlsPort ]]; then
  runServerStage xrayInboundForward || return 1
fi

if [[ -n $upDomain ]]; then
  runServerStage xrayOutboundForward || return 1
else
  runServerStage xrayOutboundDirect || return 1
fi

runServerStage postInstall || return 1

blue "---------------------"
blue  "Update de_GWD [done]"
blue "---------------------"
}




