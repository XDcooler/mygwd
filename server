installIptablesRules(){
installRulesUpdater || return 1
/opt/de_GWD/ui-updateRules --routes-only || return 1

cat << 'EOF' >/opt/de_GWD/iptablesrules-up
#!/bin/bash
set -euo pipefail
iptables -w -t filter -S >/dev/null
iptables -w -t mangle -S >/dev/null
ipset list -n >/dev/null
exec 9>/run/de_GWD-server-firewall.lock
flock -x 9
cleanup() {
    local table parent chain
    for specification in 'filter INPUT DE_GWD_SERVER_INPUT' 'mangle PREROUTING DE_GWD_SERVER_PREROUTING'; do
        read -r table parent chain <<<"$specification"
        while iptables -w -t "$table" -C "$parent" -j "$chain" 2>/dev/null; do
            iptables -w -t "$table" -D "$parent" -j "$chain" || return 1
        done
        if iptables -w -t "$table" -S "$chain" >/dev/null 2>&1; then
            iptables -w -t "$table" -F "$chain"
            iptables -w -t "$table" -X "$chain"
        fi
    done
    ipset destroy de_gwd_server_chnroute 2>/dev/null || true
}
interface=$(ip -o -4 route show default | awk '{for (i=1;i<=NF;i++) if ($i=="dev") {print $(i+1); exit}}')
[[ -n $interface ]] || { echo 'No default interface; server firewall rules were not changed.' >&2; exit 1; }
xtlsPort=$(jq -r '.inbounds[]? | select(.tag == "forward") | .port // empty' /opt/de_GWD/vtrui/config.json)
while IFS= read -r port; do
    [[ -n $port ]] || continue
    [[ $port =~ ^[0-9]+$ ]] && ((10#$port > 0 && 10#$port <= 65535)) || { echo 'Invalid XTLS port; firewall rules were not changed.' >&2; exit 1; }
done <<<"$xtlsPort"
[[ -z $xtlsPort || -s /opt/de_GWD/chnrouteSET ]] || { echo 'China route data is missing.' >&2; exit 1; }
rollback() {
    local status=$?
    if ((status != 0)); then
        trap - EXIT
        set +e
        cleanup
        echo 'Server firewall setup failed; partial de_GWD rules were removed.' >&2
    fi
    exit "$status"
}
trap rollback EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
cleanup
iptables -w -t filter -N DE_GWD_SERVER_INPUT
iptables -w -t mangle -N DE_GWD_SERVER_PREROUTING
if [[ -n $xtlsPort ]]; then
    ipset create de_gwd_server_chnroute hash:net family inet hashsize 4096 maxelem 100000
    sed 's/^add chnroute /add de_gwd_server_chnroute /' /opt/de_GWD/chnrouteSET | ipset restore -exist
    while IFS= read -r port; do
        [[ -n $port ]] || continue
        iptables -w -t filter -A DE_GWD_SERVER_INPUT -m set --match-set de_gwd_server_chnroute src -p tcp --dport "$port" -j DROP
    done <<<"$xtlsPort"
fi
for protocol in udp tcp; do
    iptables -w -t filter -A DE_GWD_SERVER_INPUT -p "$protocol" --dport 53 -i "$interface" -j DROP
done
iptables -w -t mangle -A DE_GWD_SERVER_PREROUTING -p tcp --tcp-flags FIN,SYN,RST,PSH,ACK,URG NONE -j DROP
iptables -w -t mangle -A DE_GWD_SERVER_PREROUTING -p tcp --tcp-flags FIN,SYN FIN,SYN -j DROP
iptables -w -t mangle -A DE_GWD_SERVER_PREROUTING -p tcp --tcp-flags SYN,RST SYN,RST -j DROP
iptables -w -t mangle -A DE_GWD_SERVER_PREROUTING -p tcp --tcp-flags SYN,FIN SYN,FIN -j DROP
iptables -w -t mangle -A DE_GWD_SERVER_PREROUTING -p tcp --tcp-flags FIN,RST FIN,RST -j DROP
iptables -w -t mangle -A DE_GWD_SERVER_PREROUTING -p tcp --tcp-flags FIN,ACK FIN -j DROP
iptables -w -t mangle -A DE_GWD_SERVER_PREROUTING -p tcp --tcp-flags ACK,URG URG -j DROP
iptables -w -t mangle -A DE_GWD_SERVER_PREROUTING -p tcp --tcp-flags ACK,FIN FIN -j DROP
iptables -w -t mangle -A DE_GWD_SERVER_PREROUTING -p tcp --tcp-flags ACK,PSH PSH -j DROP
iptables -w -t mangle -A DE_GWD_SERVER_PREROUTING -p tcp --tcp-flags ALL ALL -j DROP
iptables -w -t mangle -A DE_GWD_SERVER_PREROUTING -p tcp --tcp-flags ALL NONE -j DROP
iptables -w -t mangle -A DE_GWD_SERVER_PREROUTING -p tcp --tcp-flags ALL FIN,PSH,URG -j DROP
iptables -w -t mangle -A DE_GWD_SERVER_PREROUTING -p tcp --tcp-flags ALL SYN,FIN,PSH,URG -j DROP
iptables -w -t mangle -A DE_GWD_SERVER_PREROUTING -p tcp --tcp-flags ALL SYN,RST,ACK,FIN,URG -j DROP
iptables -w -t filter -I INPUT 1 -j DE_GWD_SERVER_INPUT
iptables -w -t mangle -I PREROUTING 1 -j DE_GWD_SERVER_PREROUTING
trap - EXIT
EOF
chmod +x /opt/de_GWD/iptablesrules-up

cat << 'EOF' >/opt/de_GWD/iptablesrules-down
#!/bin/bash
set -euo pipefail
iptables -w -t filter -S >/dev/null
iptables -w -t mangle -S >/dev/null
ipset list -n >/dev/null
exec 9>/run/de_GWD-server-firewall.lock
flock -x 9
cleanup() {
    local table parent chain
    for specification in 'filter INPUT DE_GWD_SERVER_INPUT' 'mangle PREROUTING DE_GWD_SERVER_PREROUTING'; do
        read -r table parent chain <<<"$specification"
        while iptables -w -t "$table" -C "$parent" -j "$chain" 2>/dev/null; do
            iptables -w -t "$table" -D "$parent" -j "$chain" || return 1
        done
        if iptables -w -t "$table" -S "$chain" >/dev/null 2>&1; then
            iptables -w -t "$table" -F "$chain"
            iptables -w -t "$table" -X "$chain"
        fi
    done
    ipset destroy de_gwd_server_chnroute 2>/dev/null || true
}
cleanup
EOF
