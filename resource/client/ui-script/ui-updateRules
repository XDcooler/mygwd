#!/bin/bash
set -euo pipefail
exec python3 - "$@" <<'PY_RULE_UPDATE'
import argparse
from datetime import datetime, timezone
import fcntl
import hashlib
import ipaddress
import json
import os
from pathlib import Path
import re
import runpy
import shutil
import sqlite3
import subprocess
import tempfile

SOURCES = {
    'geodata': ('Loyalsoldier/v2ray-rules-dat', 'release'),
    'routes': ('misakaio/chnroutes2', 'master'),
    'stevenblack': ('StevenBlack/hosts', 'master'),
    'anti-ad': ('privacy-protection-tools/anti-AD', 'master'),
}
ADLISTS = [
    'https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts',
    'https://raw.githubusercontent.com/privacy-protection-tools/anti-AD/master/anti-ad-domains.txt',
]

def resolve_source(repository, branch):
    # Some gateways can reach the GitHub API and raw content while Git's HTTP
    # endpoint stalls. Resolve the immutable commit over verified HTTPS first.
    try:
        result = subprocess.run(['curl', '--fail', '--silent', '--show-error',
                                 '--proto', '=https', '--connect-timeout', '10', '--max-time', '20',
                                 'https://api.github.com/repos/' + repository + '/commits/' + branch],
                                capture_output=True, text=True, check=True, timeout=25)
        commit = json.loads(result.stdout).get('sha', '')
        if isinstance(commit, str) and re.fullmatch(r'[a-f0-9]{40}', commit):
            return commit
    except (ValueError, AttributeError, OSError, subprocess.SubprocessError):
        pass
    result = subprocess.run(['git', 'ls-remote', 'https://github.com/' + repository + '.git',
                             'refs/heads/' + branch], capture_output=True, text=True,
                            check=True, timeout=25)
    commit = result.stdout.split()[0] if result.stdout.split() else ''
    if re.fullmatch(r'[a-f0-9]{40}', commit) is None:
        raise ValueError('Unable to resolve rule source: ' + repository)
    return commit

def download(url, destination):
    subprocess.run(['curl', '--fail', '--silent', '--show-error', '--location',
                    '--proto', '=https', '--proto-redir', '=https', '--retry', '2',
                    '--connect-timeout', '15', '--max-time', '180',
                    '--speed-limit', '1024', '--speed-time', '30',
                    '--output', str(destination), url], check=True)
    if not destination.is_file() or destination.stat().st_size == 0:
        raise ValueError('Empty rule download: ' + url)

def varint(data, offset):
    value = 0
    for shift in range(0, 70, 7):
        if offset >= len(data):
            raise ValueError('Truncated protobuf')
        byte = data[offset]
        offset += 1
        value |= (byte & 127) << shift
        if byte < 128:
            return value, offset
    raise ValueError('Invalid protobuf varint')

def fields(data):
    offset = 0
    while offset < len(data):
        tag, offset = varint(data, offset)
        number, wire = tag >> 3, tag & 7
        if number == 0:
            raise ValueError('Invalid protobuf field')
        if wire == 0:
            value, offset = varint(data, offset)
        elif wire in (1, 5):
            size = 8 if wire == 1 else 4
            value = data[offset:offset + size]
            offset += size
            if len(value) != size:
                raise ValueError('Truncated protobuf field')
        elif wire == 2:
            size, offset = varint(data, offset)
            value = data[offset:offset + size]
            offset += size
            if len(value) != size:
                raise ValueError('Truncated protobuf field')
        else:
            raise ValueError('Unsupported protobuf wire type')
        yield number, wire, value

def geodata_tags(data):
    tags = set()
    for number, wire, entry in fields(data):
        if number == 1 and wire == 2:
            for field, kind, value in fields(entry):
                if field == 1 and kind == 2:
                    tags.add(value.decode('ascii').upper())
    return tags

def verify_geodata(path, checksum_path, required):
    checksum = checksum_path.read_text().strip().split()
    if len(checksum) != 2 or re.fullmatch(r'[a-fA-F0-9]{64}', checksum[0]) is None \
            or checksum[1].lstrip('*') != path.name:
        raise ValueError('Invalid checksum file: ' + checksum_path.name)
    digest = hashlib.sha256(path.read_bytes()).hexdigest()
    if digest != checksum[0].lower():
        raise ValueError('Checksum mismatch: ' + path.name)
    tags = geodata_tags(path.read_bytes())
    if not required <= tags:
        raise ValueError('Missing required geodata tags: ' + ','.join(sorted(required - tags)))
    return tags

def parse_routes(text):
    networks = set()
    for line in text.splitlines():
        line = line.split('#', 1)[0].strip()
        if not line:
            continue
        network = ipaddress.ip_network(line, strict=True)
        if network.version != 4:
            raise ValueError('Expected IPv4 route: ' + line)
        networks.add(network)
    if not networks:
        raise ValueError('Empty China route list')
    return sorted(networks, key=lambda item: (int(item.network_address), item.prefixlen))

def domain_valid(domain):
    if len(domain) > 253 or '.' not in domain or domain.endswith('.localhost') \
            or domain.endswith('.localdomain'):
        return False
    return all(re.fullmatch(r'[a-z0-9](?:[a-z0-9_-]{0,61}[a-z0-9])?', label)
               for label in domain.split('.'))

def parse_ads(text, hosts=False):
    domains = set()
    for line in text.splitlines():
        parts = line.split('#', 1)[0].strip().lower().split()
        if not parts:
            continue
        if hosts:
            if parts[0] not in ('0.0.0.0', '127.0.0.1'):
                continue
            candidates = parts[1:]
        else:
            if len(parts) != 1:
                raise ValueError('Invalid advertising domain record')
            candidates = parts
        for domain in candidates:
            if domain in ('localhost', 'localhost.localdomain', 'local', 'broadcasthost'):
                continue
            try:
                ipaddress.ip_address(domain)
            except ValueError:
                pass
            else:
                # Hosts sources include address placeholders which are not DNS names.
                continue
            if not domain_valid(domain):
                raise ValueError('Invalid advertising domain: ' + domain)
            domains.add(domain)
    if not domains:
        raise ValueError('Empty advertising domain list')
    return domains

def stage_rules(stage, routes_only=False):
    source_names = ['routes'] if routes_only else list(SOURCES)
    versions = {}
    for name in source_names:
        repository, branch = SOURCES[name]
        commit = resolve_source(repository, branch)
        versions[name] = {'repository': repository, 'branch': branch, 'commit': commit}
    def fetch(source, filename, destination):
        version = versions[source]
        url = 'https://raw.githubusercontent.com/{}/{}/{}'.format(version['repository'], version['commit'], filename)
        download(url, stage/destination)

    counts = {}
    if not routes_only:
        for name, required in [('geoip.dat', {'CN', 'PRIVATE'}),
                               ('geosite.dat', {'CN', 'PRIVATE', 'APPLE', 'APPLE-CN', 'NETFLIX', 'CATEGORY-ADS-ALL'})]:
            fetch('geodata', name, name)
            fetch('geodata', name + '.sha256sum', name + '.sha256sum')
            counts[name + '_tags'] = len(verify_geodata(stage/name, stage/(name+'.sha256sum'), required))
        fetch('stevenblack', 'hosts', 'stevenblack.hosts')
        fetch('anti-ad', 'anti-ad-domains.txt', 'anti-ad.source')
        global_ads = parse_ads((stage/'stevenblack.hosts').read_text(), hosts=True)
        chinese_ads = parse_ads((stage/'anti-ad.source').read_text())
        domains = sorted(global_ads | chinese_ads)
        (stage/'ads-domains.txt').write_text('\n'.join(domains) + '\n')
        (stage/'adlists.list').write_text('\n'.join(ADLISTS) + '\n')
        counts.update(stevenblack_domains=len(global_ads), anti_ad_domains=len(chinese_ads),
                      advertising_domains=len(domains))
        (stage/'stevenblack.hosts').unlink()
        (stage/'anti-ad.source').unlink()
    fetch('routes', 'chnroutes.txt', 'chnroutes.txt')
    networks = parse_routes((stage/'chnroutes.txt').read_text())
    (stage/'chnroutes.txt').write_text('\n'.join(map(str, networks)) + '\n')
    (stage/'chnrouteSET').write_text(''.join('add chnroute ' + str(network) + '\n' for network in networks))
    counts['china_ipv4_routes'] = len(networks)
    manifest = {'updated_at_utc': datetime.now(timezone.utc).isoformat(), 'sources': versions,
                'counts': counts, 'files': {path.name: {'sha256': hashlib.sha256(path.read_bytes()).hexdigest(),
                                                       'bytes': path.stat().st_size}
                                          for path in sorted(stage.iterdir()) if path.is_file()}}
    (stage/'manifest.json').write_text(json.dumps(manifest, ensure_ascii=False, indent=2) + '\n')
    return manifest

def atomic_copy(source, destination):
    destination.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix='.' + destination.name + '.', dir=destination.parent)
    try:
        with os.fdopen(fd, 'wb') as output:
            output.write(source.read_bytes())
        os.chmod(temporary, 0o644)
        os.replace(temporary, destination)
    finally:
        Path(temporary).unlink(missing_ok=True)

def register_adlists(directory):
    directory.mkdir(parents=True, exist_ok=True)
    database = directory/'gravity.db'
    if database.is_file():
        with sqlite3.connect(database, timeout=30) as connection:
            if not connection.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='adlist'").fetchone():
                raise ValueError('Pi-hole gravity database has no adlist table')
            for address in ADLISTS:
                connection.execute('INSERT OR IGNORE INTO adlist (address, enabled, comment) VALUES (?, 1, ?)',
                                   (address, 'de_GWD managed advertising source'))
    else:
        # Seed old and new Pi-hole installers without removing existing sources.
        path = directory/'adlists.list'
        existing = path.read_text() if path.exists() else ''
        records = {line.strip() for line in existing.splitlines()}
        missing = [address for address in ADLISTS if address not in records]
        if missing:
            content = existing + ('\n' if existing and not existing.endswith('\n') else '') + '\n'.join(missing) + '\n'
            with tempfile.TemporaryDirectory(dir=directory) as folder:
                source = Path(folder)/'adlists.list'
                source.write_text(content)
                atomic_copy(source, path)

def refresh_ipset(rules):
    if not shutil.which('ipset'):
        print('ipset unavailable; validated route file is ready for installation.')
        return
    temporary = 'chnroute_update_' + str(os.getpid())
    options = ['hash:net', 'family', 'inet', 'hashsize', '4096', 'maxelem', '100000']
    subprocess.run(['ipset', 'create', temporary] + options, check=True)
    try:
        entries = rules.read_text().replace('add chnroute ', 'add ' + temporary + ' ')
        subprocess.run(['ipset', 'restore'], input=entries, text=True, check=True)
        subprocess.run(['ipset', 'create', 'chnroute'] + options + ['-exist'], check=True)
        subprocess.run(['ipset', 'swap', temporary, 'chnroute'], check=True)
    finally:
        subprocess.run(['ipset', 'destroy', temporary], check=False)

def deploy_rules(directory, root, pihole_directory, routes_only=False):
    atomic_copy(directory/'chnrouteSET', root/'chnrouteSET')
    refresh_ipset(root/'chnrouteSET')
    if routes_only:
        return
    for component in ['v2dns', 'vtrui']:
        target = root/component
        if target.is_dir():
            for filename in ['geoip.dat', 'geosite.dat']:
                atomic_copy(directory/filename, target/filename)
    # Rebuild selected service rules against the newly verified classifications.
    # This also preserves explicit-domain fallbacks when an upstream category vanishes.
    service_helper = root/'ui-serviceRoutes'
    if service_helper.is_file() and (root/'0conf').is_file():
        # The updater already holds the deployment directory lock. Use the
        # trusted installed compiler as a library, avoiding a second lock.
        compiler = runpy.run_path(str(root/'service-routing.py'))
        configuration = json.loads(root.joinpath('0conf').read_text())
        compiler['apply'](root, json.loads(root.joinpath('service-catalog.json').read_text()),
                          configuration, compiler['saved_policies'](configuration), restart=False)
    register_adlists(pihole_directory)
    if shutil.which('pihole'):
        subprocess.run(['pihole', '-g'], check=True)
    else:
        print('Pi-hole unavailable; adlist sources are saved but filtering has not been activated.')
    if shutil.which('systemctl'):
        for service in ['v2dns', 'vtrui', 'vtrui1', 'iptables-proxy', 'pihole-FTL']:
            status = subprocess.run(['systemctl', 'is-active', '--quiet', service],
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if status.returncode == 0:
                subprocess.run(['systemctl', 'restart', service], check=True)

def remember(paths):
    return {path: (path.read_bytes(), path.stat().st_mode & 0o777,
                   path.stat().st_uid, path.stat().st_gid) if path.is_file() else None
            for path in paths}

def restore(snapshot):
    for path, saved in snapshot.items():
        if saved is None:
            path.unlink(missing_ok=True)
            continue
        content, mode, uid, gid = saved
        path.parent.mkdir(parents=True, exist_ok=True)
        fd, temporary = tempfile.mkstemp(dir=path.parent)
        try:
            with os.fdopen(fd, 'wb') as output:
                output.write(content)
            os.chmod(temporary, mode)
            if os.geteuid() == 0:
                os.chown(temporary, uid, gid)
            os.replace(temporary, path)
        finally:
            Path(temporary).unlink(missing_ok=True)

def update_status(root, state, **details):
    root.mkdir(parents=True, exist_ok=True)
    payload = {'state': state, 'checked_at_utc': datetime.now(timezone.utc).isoformat(), **details}
    with tempfile.TemporaryDirectory(dir=root) as folder:
        source = Path(folder)/'status.json'
        source.write_text(json.dumps(payload) + '\n')
        atomic_copy(source, root/'rule-update-status.json')

def bootstrap_routes(directory, root):
    """Use the verified checkout snapshot while the proxy core is being rebuilt."""
    directory, root = Path(directory), Path(root)
    manifest = json.loads((directory/'manifest.json').read_text())
    source = directory/'chnroutes.txt'
    try:
        expected = manifest['files']['chnroutes.txt']['sha256']
    except (KeyError, TypeError):
        raise ValueError('Invalid bootstrap route manifest') from None
    if hashlib.sha256(source.read_bytes()).hexdigest() != expected:
        raise ValueError('Bootstrap route checksum mismatch')
    networks = parse_routes(source.read_text())
    root.mkdir(parents=True, exist_ok=True)
    lock = os.open(root, os.O_RDONLY)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        target = root/'chnrouteSET'
        snapshot = remember([target])
        with tempfile.TemporaryDirectory(dir=root) as folder:
            candidate = Path(folder)/'chnrouteSET'
            candidate.write_text(''.join('add chnroute ' + str(n) + '\n' for n in networks))
            try:
                atomic_copy(candidate, target)
                refresh_ipset(target)
            except Exception:
                restore(snapshot)
                raise
        print(json.dumps({'bootstrap_china_ipv4_routes': len(networks),
                          'snapshot_updated_at_utc': manifest.get('updated_at_utc')}))
    finally:
        os.close(lock)

def update_rules(directory, root, pihole_directory, routes_only=False, data_only=False):
    directory = Path(directory)
    root, pihole_directory = Path(root), Path(pihole_directory)
    directory.parent.mkdir(parents=True, exist_ok=True)
    # Lock the parent directory without creating persistent lock files in the checkout.
    lock = os.open(directory.parent, os.O_RDONLY)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        if not data_only:
            update_status(root, 'running')
        with tempfile.TemporaryDirectory(prefix='.rules-stage-', dir=directory.parent) as folder:
            stage = Path(folder)
            # No existing file is replaced until every requested download has passed validation.
            manifest = stage_rules(stage, routes_only)
            directory.mkdir(parents=True, exist_ok=True)
            paths = {directory/path.name for path in stage.iterdir()}
            if not data_only:
                paths.update(root/name for name in ('chnrouteSET', '0conf', 'vtrui/config.json',
                             'IPconsoleSET', 'IPserviceSET', 'services-dnsmasq.conf'))
                if root == Path('/opt/de_GWD'):
                    paths.add(Path('/etc/dnsmasq.d/90-de-gwd-services.conf'))
                paths.update(root/component/name for component in ('v2dns', 'vtrui')
                             for name in ('geoip.dat', 'geosite.dat'))
            snapshot = remember(paths)
            active_units = []
            if not data_only and shutil.which('systemctl'):
                active_units = [unit for unit in ('v2dns', 'vtrui', 'vtrui1', 'iptables-proxy', 'pihole-FTL')
                                if subprocess.run(['systemctl', 'is-active', '--quiet', unit], capture_output=True).returncode == 0]
            try:
                for path in sorted(stage.iterdir(), key=lambda item: item.name == 'manifest.json'):
                    atomic_copy(path, directory/path.name)
                if not data_only:
                    deploy_rules(directory, root, pihole_directory, routes_only)
            except Exception:
                restore(snapshot)
                if not data_only and (root/'chnrouteSET').is_file():
                    try:
                        refresh_ipset(root/'chnrouteSET')
                        if shutil.which('systemctl'):
                            for unit in active_units:
                                subprocess.run(['systemctl', 'restart', unit], check=True, capture_output=True, timeout=90)
                    except (OSError, subprocess.SubprocessError):
                        update_status(root, 'failed', recovery_failed=True, message='规则文件已恢复；服务恢复失败，需要检查服务。')
                        raise ValueError('Rules restored, but service recovery needs attention') from None
                raise
        if not data_only:
            update_status(root, 'success', updated_at_utc=manifest['updated_at_utc'], counts=manifest['counts'])
        print(json.dumps(manifest['counts'], ensure_ascii=False))
        return manifest
    finally:
        os.close(lock)

def main():
    parser = argparse.ArgumentParser(description='Update verified GeoIP, GeoSite, China IPv4 routes and Pi-hole adlists.')
    parser.add_argument('--directory', default='/opt/de_GWD/rules')
    parser.add_argument('--root', default='/opt/de_GWD')
    parser.add_argument('--pihole-directory', default='/etc/pihole')
    parser.add_argument('--routes-only', action='store_true')
    parser.add_argument('--data-only', action='store_true')
    parser.add_argument('--bootstrap-routes', help='Install checksum-verified routes from a local checkout snapshot before rebuilding the proxy')
    args = parser.parse_args()
    try:
        if args.bootstrap_routes:
            bootstrap_routes(args.bootstrap_routes, args.root)
            return
        update_rules(args.directory, args.root, args.pihole_directory, args.routes_only, args.data_only)
    except (OSError, ValueError, sqlite3.Error, subprocess.SubprocessError) as error:
        if not args.data_only and not isinstance(error, BlockingIOError):
            previous = Path(args.root)/'rule-update-status.json'
            progress = json.loads(previous.read_text()) if previous.exists() else {}
            if not progress.get('recovery_failed'):
                update_status(Path(args.root), 'failed', message='更新未完成，保留上次验证的规则。请检查网络与服务日志。')
        parser.exit(1, 'Rule update failed; previous verified files preserved. Check the network and service logs.\n')

if __name__ == '__main__':
    main()
PY_RULE_UPDATE
