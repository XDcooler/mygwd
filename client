updateGWD(){
if [[ ${1:-} != --worker ]] && grep -q '/updateGWD.service' /proc/self/cgroup 2>/dev/null; then
    startDetachedUpdate
    return $?
fi
(
updateStateDirectory=/var/lib/de-gwd-update
install -d -m0700 "$updateStateDirectory" || exit 1
exec 9>"$updateStateDirectory/update.lock"
flock -n 9 || { red "Another update is already running"; exit 1; }
updatePhase=preflight
clientCronStopped=0
clientNetworkChanged=0
trap 'finishUpdate $?' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
writeUpdateStatus running || exit 1
requireDebian13 || return 1
[[ ! -f "/opt/de_GWD/version.php" ]] || { red "this is not client"; exit 1; }

if [[ ${1:-} != --worker ]]; then
    green "========================="
    green "[Y]: Update Debian System"
    green "* Any other key to skip *"
    green "========================="
    read -s -n 1 updateDebian
    echo

if [[ $updateDebian = "Y" ]] || [[ $updateDebian = "y" ]]; then
runUpdateStage updateAPT || exit 1
fi
fi

for updateStage in preUpdate preDownload cleanDep preConf SmartDNSset installXray \
    installIptablesProxy de_GWDconnect installDep installNginx nginxSet installWebUI \
    installPihole piholeSet postInstall; do
    runUpdateStage "$updateStage" || exit 1
done
blue "--------------------"
blue "Update de_GWD [done]"
blue "--------------------"
)
}



