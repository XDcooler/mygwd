# Keep the worker and its private log outside the short-lived ttyd service.
startDetachedUpdate(){
(
local directory=/var/lib/de-gwd-update
install -d -m0700 "$directory" || return 1
exec 8>"$directory/start.lock"
flock -n 8 || { red "Another update is starting"; return 1; }
if systemctl is-active --quiet de-gwd-update || ! flock -n "$directory/update.lock" true; then
    blue "An update is already running; see $directory/status.json"
    return 0
fi
install -m0700 "$clientSourcePath" "$directory/client" || return 1
: >"$directory/update.log"
chmod 0600 "$directory/update.log"
systemd-run --unit=de-gwd-update --collect --property=Type=exec \
    --property=UMask=0022 --property=StandardOutput=append:"$directory/update.log" \
    --property=StandardError=inherit /bin/bash "$directory/client" --update || return 1
blue "Update continues in de-gwd-update.service, even after the console closes."
)
}

writeUpdateStatus(){
python3 - "$updateStateDirectory" "$1" "$updatePhase" "${2:-0}" <<'PY_UPDATE_STATUS'
import json, os, sys, tempfile, time
from pathlib import Path
directory = Path(sys.argv[1])
state = dict(status=sys.argv[2], phase=sys.argv[3], exit_code=int(sys.argv[4]), updated_at=int(time.time()))
fd, name = tempfile.mkstemp(dir=directory, prefix='.status.')
with os.fdopen(fd, 'w') as target:
    json.dump(state, target)
os.replace(name, directory/'status.json')
PY_UPDATE_STATUS
}

runUpdateStage(){
updatePhase=$1
writeUpdateStatus running || return 1
"$@"
}

finishUpdate(){
local result=$1
trap - EXIT HUP INT TERM
if [[ ${clientCronStopped:-0} == 1 ]]; then
    if ! service cron restart; then
        red "Failed to restore cron; run systemctl restart cron"
        updatePhase=restoreCron
        result=1
    fi
fi
if [[ $result != 0 && ${clientNetworkChanged:-0} == 1 ]]; then
    if ! restoreUpdateDNS; then
        red "DNS recovery failed; inspect Pi-hole port 53, V2DNS port 5350 and the service journals."
    fi
fi
if [[ $result == 0 ]]; then
    writeUpdateStatus succeeded 0 || result=1
else
    writeUpdateStatus failed "$result"
    red "Update failed at $updatePhase (exit $result). Retry the official update after fixing the cause."
    red "See /var/lib/de-gwd-update/status.json and journalctl -u de-gwd-update"
fi
exit "$result"
}

captureUpdateDNS(){
[[ -n ${updateStateDirectory:-} ]] || return 0
python3 - "$updateStateDirectory/dns-before.json" <<'PY_DNS_BEFORE'
import base64, json, os, stat, sys, tomllib
from pathlib import Path
resolver = Path('/etc/resolv.conf')
native = Path('/etc/pihole/pihole.toml')
port = tomllib.loads(native.read_text()).get('dns', {}).get('port', 53) if native.exists() else 53
state = dict(port=53 if port == 1053 else port, resolver=None)
if resolver.exists():
    state['resolver'] = dict(data=base64.b64encode(resolver.read_bytes()).decode(),
        link=os.readlink(resolver) if resolver.is_symlink() else None,
        mode=stat.S_IMODE(resolver.stat().st_mode))
fd = os.open(sys.argv[1], os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, 'w') as target:
    json.dump(state, target)
PY_DNS_BEFORE
}

waitForClientDNS(){
local attempt response transport
for ((attempt=0; attempt<10; attempt++)); do
    local ready=1
    for transport in +notcp +tcp; do
        response=$(dig "$transport" @127.0.0.1 -p "${1:-53}" example.com A +time=1 +tries=1 +short 2>/dev/null)
        grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' <<<"$response" || ready=0
    done
    [[ $ready == 0 ]] || return 0
    sleep 1
done
red "Local DNS on port 53 did not answer UDP and TCP queries."
return 1
}

restoreUpdateDNS(){
local port coreChanged recovery
# The bootstrap V2DNS listener temporarily uses 53. Move it back before
# restoring Pi-hole, including failures before postInstall was reached.
recovery=$(python3 - "$updateStateDirectory/dns-before.json" <<'PY_DNS_RESTORE'
import base64, json, os, sys
from pathlib import Path
state = json.loads(Path(sys.argv[1]).read_text())
core = Path('/opt/de_GWD/v2dns/config.json')
changed = False
if core.exists():
    config = json.loads(core.read_text())
    for inbound in config.get('inbounds', []):
        if inbound.get('tag') == 'dnsin' and inbound.get('port') == 53:
            inbound['port'] = 5350
            changed = True
    if changed:
        temporary = core.with_name('.dns-recovery.json')
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, 'w') as target:
            json.dump(config, target)
        os.replace(temporary, core)
resolver = state.get('resolver')
if resolver is not None:
    path = Path('/etc/resolv.conf')
    if resolver['link'] is not None:
        if not path.is_symlink() or os.readlink(path) != resolver['link']:
            path.unlink(missing_ok=True)
            path.symlink_to(resolver['link'])
    elif path.is_symlink():
        path.unlink()
    path.write_bytes(base64.b64decode(resolver['data']))
    path.chmod(resolver['mode'])
print(state['port'], int(changed))
PY_DNS_RESTORE
) || return 1
read -r port coreChanged <<<"$recovery"
if [[ $coreChanged == 1 ]]; then systemctl restart v2dns || return 1; fi
if [[ -f /etc/pihole/pihole.toml ]]; then
    timeout 30 pihole-FTL --config dns.port "$port" >/dev/null || return 1
fi
systemctl start smartdns v2dns pihole-FTL || return 1
if ! waitForClientDNS "$port"; then
    timeout 90 systemctl restart smartdns v2dns pihole-FTL || return 1
    waitForClientDNS "$port" || return 1
fi
blue "DNS listener and the previous system resolver were restored."
}

waitForXray(){
local attempt
for ((attempt=0; attempt<50; attempt++)); do
    if systemctl is-active --quiet vtrui && [[ -n $(ss -H -lnt '( sport = :9896 )') ]]; then
        return 0
    fi
    sleep 0.1
done
red "Xray did not become ready; inspect journalctl -u vtrui"
return 1
}

restartProxyRules(){
local attempt
waitForXray || return 1
for ((attempt=0; attempt<3; attempt++)); do
    systemctl restart iptables-proxy && return 0
    sleep 1
done
red "Transparent proxy rules failed; inspect journalctl -u iptables-proxy"
return 1
}


configureStaticNetwork(){
python3 - "$localaddr" "$gatewayaddr" <<'PY_NETWORK' || return 1
import ipaddress,sys
address,gateway=map(ipaddress.IPv4Address,sys.argv[1:])
network=ipaddress.IPv4Network(str(address)+'/24',strict=False)
assert address not in (network.network_address,network.broadcast_address)
assert gateway in network and gateway != address
PY_NETWORK
[[ $ethernetnum =~ ^[a-zA-Z0-9_.:-]+$ ]] || return 1
if systemctl is-active --quiet systemd-networkd; then
    install -d -m0755 /etc/systemd/network
    cat >/etc/systemd/network/05-de-gwd-client.network <<EOF
[Match]
Name=$ethernetnum
[Network]
DHCP=no
Address=$localaddr/24
Gateway=$gatewayaddr
DNS=127.0.0.1
IPv6AcceptRA=no
EOF
    chmod 0644 /etc/systemd/network/05-de-gwd-client.network
else
    cat >/etc/network/interfaces <<EOF
source /etc/network/interfaces.d/*
auto lo
iface lo inet loopback
auto $ethernetnum
iface $ethernetnum inet static
address $localaddr
netmask 255.255.255.0
gateway $gatewayaddr
EOF
fi
}

configureClientForwarding(){
# systemd-sysctl reads sysctl.d at boot; /etc/sysctl.conf alone is insufficient
# on Debian installations without the compatibility symlink.
install -d -m0755 /etc/sysctl.d || return 1
printf '# de_GWD gateway: keep direct LAN forwarding enabled.\nnet.ipv4.ip_forward = 1\n' \
    >/etc/sysctl.d/90-de-gwd-forwarding.conf || return 1
chmod 0644 /etc/sysctl.d/90-de-gwd-forwarding.conf || return 1
sysctl -q -w net.ipv4.ip_forward=1
}


