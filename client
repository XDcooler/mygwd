#!/bin/bash
# Debian's time service owns the clock. An HTTP probe must neither block
# gateway finalization nor step the clock from an unauthenticated Date header.
if ! timeout 5 timedatectl show --property=NTPSynchronized --value 2>/dev/null | grep -qx yes; then
    echo 'System NTP is not synchronized; check the configured time service.' >&2
fi
exit 0
EOF
chmod +x /opt/de_GWD/tcpTime
/opt/de_GWD/tcpTime

echo
}



