migrateUpdateSource(){
# Reuse the installed broker's atomic writer and lock, without running an update.
python3 - /opt/de_GWD/ui-panel <<'PY_UPDATE_SOURCE'
import fcntl
import json
import runpy
import os
import sys

os.umask(0o077)
broker = runpy.run_path(sys.argv[1])
private = broker['PRIVATE']
private.mkdir(mode=0o700, parents=True, exist_ok=True)
with (private/'management.lock').open('a') as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    config = json.loads(broker['CONFIG'].read_text())
    if not isinstance(config, dict):
        raise ValueError('Invalid client configuration')
    update = config.get('update', {})
    if not isinstance(update, dict):
        raise ValueError('Invalid update metadata')
    if update.get('updateCMD') != broker['UPDATE_CMD']:
        broker['set_value'](config, ['update', 'updateCMD'], broker['UPDATE_CMD'])
        broker['save'](config)
PY_UPDATE_SOURCE
}



